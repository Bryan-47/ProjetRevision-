  resource: creneaux
  id: 1
}

headers {
  content-type: application/json
}

body:json {
  {
    "classe_id": 1,
    "cours_id": 2,
    "jour": "jeudi",
    "heure_debut": "08:05",
    "heure_fin": "11:40",
    "salle": "R104"
  }
}